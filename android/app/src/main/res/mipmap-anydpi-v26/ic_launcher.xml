<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this file Android 8+ treats ic_launcher.png as a legacy icon and
  composites it onto a white plate, which is where the white border around the
  black square came from.

  An adaptive icon is two layers on a 108dp canvas, of which only the central
  72dp is guaranteed visible — launchers mask the rest to whatever shape they
  use. The mark is drawn to sit inside that safe zone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
