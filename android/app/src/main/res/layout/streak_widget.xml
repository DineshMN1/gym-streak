<?xml version="1.0" encoding="utf-8"?>
<!--
  Colours are literals rather than theme references: a widget renders inside the
  launcher's process, so it cannot resolve the app's theme. They mirror
  AppColors in lib/core/theme/app_theme.dart — background #0D0D0D, primary
  #AAFF00, secondary text #B0B0B0.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/streak_widget_background">

    <TextView
        android:id="@+id/streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#AAFF00"
        android:textSize="40sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:contentDescription="Current streak" />

    <TextView
        android:id="@+id/streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="days streak"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/streak_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Best 0"
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
